# Base URL of Stellation's FastAPI backend (used for /api/chart to read
# today's live planetary positions). Not an actual MCP connection despite
# the var name — see README's Stellation Integration section.
# Points at the deployed instance by default; swap to http://localhost:8420
# when running Stellation's backend locally instead.
STELLATION_MCP_URL=https://stellation.adhdesigns.dev

# Powers interpretive text generation (Claude Sonnet 5). Runs on every
# anonymous reading (no login required) — falls back to a template-based
# interpretation if unset or the API call fails.
# ANTHROPIC_API_KEY=

# Reading persistence (save/load), backed by Convex. Run `npx convex dev`
# once to log in, create/link the project, and populate convex/_generated —
# it writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL here automatically.
# Without these, the app still runs — the Save button just says saving
# isn't configured yet.
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
